rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // helper functions
    function hasAdminRole() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // USERS (Common in both)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) || hasAdminRole();

      match /fcm_tokens/{tokenId} {
        allow read: if isOwner(userId) || hasAdminRole();
        allow write: if isOwner(userId);
      }
    }

    // GOOD WISHES SPECIFIC COLLECTIONS
    match /authors/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /cott_events/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /events/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /ff_push_notifications/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /journeys/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /learn_items/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /portal_items/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /sharings/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /steps/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    match /topics/{doc} { allow read: if request.auth != null; allow write: if hasAdminRole(); }
    
    // User Journey rules (only the owner can read/write)
    match /user_journeys/{docId} {
      allow read, write: if request.auth != null && 
                           (resource == null || resource.data.userId == request.auth.uid || hasAdminRole());
    }

    // ROWY (Admin tool)
    match /_rowy_/{docId} {
      allow read: if request.auth != null && request.auth.token.roles.size() > 0;
      allow write: if hasAdminRole();
      match /{document=**} {
        allow read: if request.auth != null && request.auth.token.roles.size() > 0;
        allow write: if hasAdminRole();
      }
    }
  }
}
